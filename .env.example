# =============================================
# GitHub設定
# =============================================
# Personal Access Token（権限: Contents の Read & Write）
# 取得方法: https://github.com/settings/tokens → Fine-grained tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=zscaler-monitor
GITHUB_BRANCH=main

# =============================================
# Gmail設定
# =============================================
# 通常のパスワードではなく「アプリパスワード」を使用
# 取得方法: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 通知先メールアドレス（省略時はGMAIL_USERと同じ）
NOTIFY_TO=your-email@gmail.com

# =============================================
# Selenium 用プロキシ設定（scripts/selenium_proxy_sample.py）
# =============================================
PROXY_HOST=proxy.example.com
PROXY_PORT=8080
PROXY_USER=your-proxy-user
PROXY_PASS=your-proxy-password
# プロキシを通さないホスト（任意、カンマ区切り）
PROXY_BYPASS=localhost,127.0.0.1
# true で画面を表示せずに実行
HEADLESS=false
